<UserControl x:Class="UpsMaintenanceApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" BorderThickness="0,0,0,1" BorderBrush="#D7DCE3" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Configure AI and application preferences"
                           FontSize="12" Foreground="#5A6474" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="680" HorizontalAlignment="Left">

                <!-- AI Config -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="AI Configuration"/>

                        <TextBlock Text="OpenAI API Key" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SmallLabel}" Margin="0,0,0,6"
                                   Text="Stored in OPENAI_API_KEY environment variable or saved here."/>
                        <PasswordBox x:Name="TxtApiKey" Height="36" FontSize="13"
                                     Padding="8,0" BorderBrush="#D7DCE3" BorderThickness="1"/>
                        <TextBlock x:Name="TxtApiKeyStatus" FontSize="11" Foreground="#5A6474" Margin="0,4,0,0"/>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="Model" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CboModel" Height="36" FontSize="13"
                                  BorderBrush="#D7DCE3" SelectedIndex="0">
                            <ComboBoxItem Content="gpt-4o"/>
                            <ComboBoxItem Content="gpt-4o-mini"/>
                            <ComboBoxItem Content="gpt-4-turbo"/>
                        </ComboBox>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="Temperature" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Lower = more deterministic (0.0 – 1.0). Recommended: 0.2"
                                   Style="{StaticResource SmallLabel}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldTemperature" Minimum="0" Maximum="1" Value="0.2"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Text="{Binding ElementName=SldTemperature, Path=Value, StringFormat=F1}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- App Config -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Application"/>

                        <TextBlock Text="Asset ID" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtAssetId" Text="UPS-01" Height="36" FontSize="13"
                                 Padding="8,0" BorderBrush="#D7DCE3" BorderThickness="1"/>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="UPS Model" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtUpsModel" Text="HiPulse V UPS" Height="36" FontSize="13"
                                 Padding="8,0" BorderBrush="#D7DCE3" BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="About"/>
                        <TextBlock FontSize="12" Foreground="#5A6474" LineHeight="22">
                            <Run Text="Vertiv Predictive Maintenance Console" FontWeight="SemiBold"/>
                            <LineBreak/>
                            <Run Text="Version 1.0  |  Technovision 2026"/>
                            <LineBreak/>
                            <Run Text="Powered by OpenAI gpt-4o  |  .NET 10 WPF"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnSave" Content="💾  Save Settings" Click="BtnSave_Click"
                        Padding="20,10" Background="#2563EB" Foreground="White"
                        BorderBrush="Transparent" FontSize="13" FontWeight="SemiBold"
                        HorizontalAlignment="Left"/>

                <TextBlock x:Name="TxtSaveStatus" FontSize="11" Margin="0,8,0,0"
                           Foreground="#16A34A" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>