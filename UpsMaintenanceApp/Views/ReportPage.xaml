<UserControl x:Class="UpsMaintenanceApp.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F7FB">
    <UserControl.Resources>
        <Style x:Key="RptCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="20"/>
            <Setter Property="Margin"          Value="0,0,0,16"/>
        </Style>
        <Style x:Key="RptAccent" TargetType="Border">
            <Setter Property="BorderBrush"     Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="Margin"          Value="0,0,0,14"/>
            <Setter Property="Background"      Value="#EFF6FF"/>
        </Style>
        <Style x:Key="RptH1" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style x:Key="RptLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style x:Key="RptSubHead" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="RptActionItem" TargetType="Border">
            <Setter Property="BorderBrush"     Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Background="White" BorderThickness="0,0,0,1" BorderBrush="#D7DCE3" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VPMS Analysis Report" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtReportDate" Text="No analysis completed yet"
                               FontSize="12" Foreground="#5A6474" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🖨  Print Report" Click="BtnPrint_Click"
                        Padding="14,8" Background="#1E293B" Foreground="White"
                        BorderBrush="Transparent" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Scrollable body — white for print-friendliness -->
        <ScrollViewer Grid.Row="1" Background="White" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ReportContent" Margin="32,24" MaxWidth="900" HorizontalAlignment="Left">

                <!-- Placeholder -->
                <Border x:Name="NoDataPanel" Style="{StaticResource RptCard}">
                    <TextBlock Text="Complete an analysis on the Upload Visit page to generate a report."
                               FontSize="13" Foreground="#5A6474"
                               HorizontalAlignment="Center" Padding="20"/>
                </Border>

                <StackPanel x:Name="ReportBody" Visibility="Collapsed">

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 1 — Executive Summary
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="1.   Executive Summary" Style="{StaticResource RptH1}"/>
                            </Border>

                            <TextBlock x:Name="TxtSiteDate" Style="{StaticResource RptLabel}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock x:Name="TxtSummary" FontSize="13" TextWrapping="Wrap"
                                       Foreground="#374151" LineHeight="22"/>

                            <!-- 3 headline badges -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="6"
                                        Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Health Index" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHealthIndex" FontSize="38" FontWeight="Bold"
                                                   Foreground="#2563EB" HorizontalAlignment="Center"/>
                                        <TextBlock Text="/ 100" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="6"
                                        Padding="16,12" Margin="0,0,8,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Maintenance Urgency" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                        <TextBlock x:Name="TxtUrgency" FontSize="24" FontWeight="Bold"
                                                   Foreground="#C2410C" HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="6" Padding="16,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="AI Confidence" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtConfidence" FontSize="24" FontWeight="Bold"
                                                   Foreground="#15803D" HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 2 — System Health Dashboard
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="2.   System Health Dashboard" Style="{StaticResource RptH1}"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Battery -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="4">
                                    <TextBlock Text="Battery" Style="{StaticResource RptLabel}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtBattHealth" FontSize="34" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="PbBatt" Height="8" Maximum="100" Margin="4,4"/>
                                    <TextBlock x:Name="TxtBattStatus" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- DC Link -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="4">
                                    <TextBlock Text="DC Link" Style="{StaticResource RptLabel}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtDcHealth" FontSize="34" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="PbDc" Height="8" Maximum="100" Margin="4,4"/>
                                    <TextBlock x:Name="TxtDcStatus" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Power Stage -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="4">
                                    <TextBlock Text="Power Stage" Style="{StaticResource RptLabel}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtPwrHealth" FontSize="34" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="PbPwr" Height="8" Maximum="100" Margin="4,4"/>
                                    <TextBlock x:Name="TxtPwrStatus" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Thermal Stress (inverted: lower is better) -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Margin="4">
                                    <TextBlock Text="Thermal Stress" Style="{StaticResource RptLabel}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtThermHealth" FontSize="34" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <ProgressBar x:Name="PbTherm" Height="8" Maximum="100" Margin="4,4"/>
                                    <TextBlock x:Name="TxtThermStatus" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Overall separator + big number -->
                                <Border Grid.Column="4" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"
                                        Padding="20,0,4,0" Margin="8,0,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Overall" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Health" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtOverallHealth" FontSize="52" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="/ 100" Style="{StaticResource RptLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 3 — Detected Issues
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="3.   Detected Issues" Style="{StaticResource RptH1}"/>
                            </Border>

                            <ItemsControl x:Name="IssuesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RptActionItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{Binding SeverityColor}"
                                                        CornerRadius="3" Padding="6,2"
                                                        Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Severity}"
                                                               Foreground="White" FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="#374151"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtNoIssues" Text="No critical issues detected during this log period."
                                       FontSize="12" Foreground="#64748B"
                                       Margin="0,4" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 4 — Root Cause Analysis
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="4.   Root Cause Analysis" Style="{StaticResource RptH1}"/>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Primary Root Cause" Style="{StaticResource RptLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtRootCause" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#1E293B" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="RcConfBadge" CornerRadius="4"
                                        Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="TxtRcConfidence" FontSize="11"
                                               FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Supporting Evidence / Patterns" Style="{StaticResource RptSubHead}"/>
                            <ItemsControl x:Name="PatternsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,7">
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <Run Text="▸  " Foreground="#3B82F6"/>
                                                <Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 5 — Fishbone (Ishikawa) Diagram
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="5.   Root Cause Fishbone (Ishikawa) Diagram"
                                           Style="{StaticResource RptH1}"/>
                            </Border>

                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4"
                                    Background="#FAFAFA" Padding="8">
                                <Canvas x:Name="FishboneCanvas" Width="720" Height="300"
                                        HorizontalAlignment="Left"/>
                            </Border>

                            <TextBlock Text="Rib categories: upper = Input Power / DC Link / Inverter;  lower = Bypass / Battery / Thermal.  Sub-branches show detected event patterns."
                                       Style="{StaticResource RptLabel}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 6 — Corrective Actions
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="6.   Corrective Actions" Style="{StaticResource RptH1}"/>
                            </Border>

                            <!-- Immediate -->
                            <Border Background="#FEF2F2" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="⚡  Immediate Actions" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#DC2626" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="ImmediateList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="0,7">
                                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                                        <Run Text="●  " Foreground="#DC2626"/>
                                                        <Run Text="{Binding Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtNoImmediate" Text="None"
                                               FontSize="12" Foreground="#EF4444"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Scheduled -->
                            <Border Background="#FFFBEB" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📅  Scheduled Actions" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#B45309" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="ScheduledList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="0,7">
                                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                                        <Run Text="●  " Foreground="#D97706"/>
                                                        <Run Text="{Binding Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtNoScheduled" Text="None"
                                               FontSize="12" Foreground="#D97706"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Monitor -->
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="👁  Monitor" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#15803D" Margin="0,0,0,8"/>
                                    <ItemsControl x:Name="MonitorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#BBF7D0" BorderThickness="0,0,0,1" Padding="0,7">
                                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                                        <Run Text="●  " Foreground="#16A34A"/>
                                                        <Run Text="{Binding Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtNoMonitor" Text="None"
                                               FontSize="12" Foreground="#16A34A"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 7 — Predictive Risk Assessment
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="7.   Predictive Risk Assessment  (if no corrective action taken)"
                                           Style="{StaticResource RptH1}"/>
                            </Border>

                            <DataGrid x:Name="RiskProjectionGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="1" BorderBrush="#E2E8F0"
                                      Background="White" RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      FontSize="12" RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Component"    Binding="{Binding Component}" Width="130" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Current (%)"  Binding="{Binding Current}"   Width="100"/>
                                    <DataGridTextColumn Header="30-Day (%)"   Binding="{Binding D30}"       Width="100"/>
                                    <DataGridTextColumn Header="60-Day (%)"   Binding="{Binding D60}"       Width="100"/>
                                    <DataGridTextColumn Header="90-Day (%)"   Binding="{Binding D90}"       Width="100"/>
                                    <DataGridTextColumn Header="Priority"     Binding="{Binding Priority}"  Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Projections assume no corrective action. 30-day = current estimate; 60-day = +30% degradation; 90-day = +60% degradation. Values capped at 99%."
                                       Style="{StaticResource RptLabel}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 8 — Engineering Appendix
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="8.   Engineering Appendix — Raw Feature Metrics"
                                           Style="{StaticResource RptH1}"/>
                            </Border>

                            <DataGrid x:Name="FeaturesGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="1" BorderBrush="#E2E8F0"
                                      Background="White" RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      MaxHeight="420" FontSize="11" RowHeight="28">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Metric"      Binding="{Binding Metric}" Width="160" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Value"       Binding="{Binding Value}"  Width="110"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Desc}"   Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="TxtDqReport" FontSize="11" Foreground="#64748B"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         SECTION 9 — Confidence & Provenance
                    ══════════════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource RptCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RptAccent}">
                                <TextBlock Text="9.   Confidence &amp; Provenance" Style="{StaticResource RptH1}"/>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Analysis Model:"
                                           Style="{StaticResource RptLabel}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="TxtModelInfo" Grid.Row="0" Grid.Column="1"
                                           FontSize="12" Foreground="#374151" Margin="0,0,0,7"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pipeline Version:"
                                           Style="{StaticResource RptLabel}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="VPMS v2.0  (5-Agent AI Pipeline: Signal → Health → Event → Prediction → Insight)"
                                           FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,7"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Analysis Completed:"
                                           Style="{StaticResource RptLabel}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="TxtAnalysisTime" Grid.Row="2" Grid.Column="1"
                                           FontSize="12" Foreground="#374151" Margin="0,0,0,7"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="AI Confidence:"
                                           Style="{StaticResource RptLabel}"/>
                                <TextBlock x:Name="TxtProvConfidence" Grid.Row="3" Grid.Column="1"
                                           FontSize="12" Foreground="#374151"/>
                            </Grid>

                            <TextBlock Text="Pipeline Execution Log:" Style="{StaticResource RptSubHead}"/>
                            <Border Background="#F8FAFC" CornerRadius="4"
                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                    Padding="12" Margin="0,0,0,24">
                                <TextBlock x:Name="TxtErrorLog" FontSize="11"
                                           FontFamily="Consolas" Foreground="#374151"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Signature block -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Reviewed By (Field Engineer):"
                                                   Style="{StaticResource RptLabel}"/>
                                        <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1"
                                                Margin="0,28,0,0" Height="1"/>
                                        <TextBlock Text="Name  /  Signature  /  Date"
                                                   Style="{StaticResource RptLabel}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                        <TextBlock Text="Approved By (Service Manager):"
                                                   Style="{StaticResource RptLabel}"/>
                                        <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1"
                                                Margin="0,28,0,0" Height="1"/>
                                        <TextBlock Text="Name  /  Signature  /  Date"
                                                   Style="{StaticResource RptLabel}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
