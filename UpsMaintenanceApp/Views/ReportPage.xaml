<UserControl x:Class="UpsMaintenanceApp.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F6F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" BorderThickness="0,0,0,1" BorderBrush="#D7DCE3" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Analysis Report" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtReportDate" Text="No analysis completed yet"
                               FontSize="12" Foreground="#5A6474" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🖨  Print" Click="BtnPrint_Click"
                        Padding="14,8" Background="#1E293B" Foreground="White"
                        BorderBrush="Transparent" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" x:Name="ReportContent">

                <!-- Placeholder -->
                <Border x:Name="NoDataPanel" Style="{StaticResource Card}">
                    <TextBlock Text="Complete an analysis on the Upload Visit page to generate a report."
                               FontSize="13" Foreground="#5A6474" HorizontalAlignment="Center" Padding="20"/>
                </Border>

                <!-- Report (hidden until data ready) -->
                <StackPanel x:Name="ReportBody" Visibility="Collapsed">

                    <!-- Summary -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Executive Summary"/>
                            <TextBlock x:Name="TxtSummary" FontSize="12" TextWrapping="Wrap"
                                       Foreground="#374151" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- 3 headline KPIs -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Overall Health"  Style="{StaticResource SmallLabel}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtRptHealth"  Text="—" FontSize="40" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                <TextBlock Text="/ 100"           Style="{StaticResource SmallLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Urgency"            Style="{StaticResource SmallLabel}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtRptUrgency"    Text="—" FontSize="28" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,8"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="AI Confidence"      Style="{StaticResource SmallLabel}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtRptConfidence" Text="—" FontSize="28" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Component Health -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Component Health Scores"/>
                            <DataGrid x:Name="HealthGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="White"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F2F5" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="*"/>
                                    <DataGridTextColumn Header="Score"     Binding="{Binding Score}"     Width="80"/>
                                    <DataGridTextColumn Header="Status"    Binding="{Binding Status}"    Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Risk Assessment -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Failure Risk Assessment"/>
                            <DataGrid x:Name="RiskGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="White"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F2F5" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="*"/>
                                    <DataGridTextColumn Header="Risk %"    Binding="{Binding Risk}"      Width="80"/>
                                    <DataGridTextColumn Header="Priority"  Binding="{Binding Priority}"  Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Recommended Actions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Recommended Actions"/>
                            <ItemsControl x:Name="ActionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F2F5" BorderThickness="0,0,0,1" Padding="0,8">
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <Run Text="✓  " Foreground="#2563EB" FontWeight="Bold"/>
                                                <Run Text="{Binding Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Root Cause -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Root Cause"/>
                            <TextBlock x:Name="TxtRptRootCause" FontSize="12" TextWrapping="Wrap" Foreground="#374151"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>