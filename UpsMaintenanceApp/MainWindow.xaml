<Window x:Class="UpsMaintenanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:views="clr-namespace:UpsMaintenanceApp.Views"
        Title="Vertiv Predictive Maintenance Console"
        Width="1440" Height="860">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ═══ SIDEBAR ═══ -->
		<Border Background="White" BorderThickness="0,0,1,0" BorderBrush="#D7DCE3">
			<StackPanel Margin="16">
				<TextBlock Text="Vertiv PM" FontSize="15" FontWeight="Bold" Margin="0,0,0,20"/>
				<Button x:Name="NavDashboard" Content="📊  Dashboard"    Tag="Dashboard" Click="Nav_Click" Style="{StaticResource NavButton}" Foreground="#2563EB" FontWeight="SemiBold"/>
				<Button x:Name="NavUpload"    Content="📁  Upload Visit"  Tag="Upload"    Click="Nav_Click" Style="{StaticResource NavButton}"/>
				<Button x:Name="NavReport"    Content="📄  Report"        Tag="Report"    Click="Nav_Click" Style="{StaticResource NavButton}"/>
				<Button x:Name="NavSettings"  Content="⚙   Settings"      Tag="Settings"  Click="Nav_Click" Style="{StaticResource NavButton}"/>
				<Separator Margin="0,16"/>
				 <Button x:Name="BtnLoadFile" Content="📂  Load Files"
                        Click="BtnLoadFile_Click"
                        Padding="10,7" Background="#2563EB" Foreground="White"
                        BorderBrush="Transparent"/>
				<ProgressBar IsIndeterminate="True" Height="10" Margin="0,10,0,4"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
				<TextBlock Text="{Binding PipelineStatus}" FontSize="11"
                           Foreground="#5A6474" TextWrapping="Wrap"/>
			</StackPanel>
		</Border>

		<!-- ═══ MAIN ═══ -->
		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="56"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- TOPBAR -->

			<Border Background="White" BorderThickness="0,0,0,1" BorderBrush="#D7DCE3">
				<Grid Margin="16,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="{Binding AssetInfo}"
                            FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Text="{Binding DataQualityInfo}"
                            FontSize="12" Foreground="#5A6474"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="2" Text="{Binding LogWindowInfo}"
                            FontSize="11" Foreground="#5A6474" VerticalAlignment="Center"/>
				</Grid>
			</Border>

			<!-- SCROLLABLE CONTENT -->
			<ScrollViewer x:Name="PageDashboard" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F6F7FB">
				<StackPanel Margin="12">

					<!-- ── SIGNAL ANALYSIS KPI STRIP ── -->
					<UniformGrid Rows="2" Columns="4" Margin="0,0,0,10">
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="Vin Std Dev (V)" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding InputVoltageVariation}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="Efficiency (%)" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding EfficiencyRating}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="Bypass Freq σ (Hz)" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding BypassFreqVariation}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="Bypass Volt σ (V)" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding BypassVoltageVariation}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="DC Link σ (V)" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding DcLinkVariation}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="Battery Backup" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding BatteryBackupStatus}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}">
							<StackPanel>
								<TextBlock Text="Vout σ (V)" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding OutputVoltageVariation}" FontSize="14" FontWeight="SemiBold"/>
							</StackPanel>
						</Border>
						<Border Style="{StaticResource KpiBox}" Margin="0">
							<StackPanel>
								<TextBlock Text="Overall Stress" Style="{StaticResource SmallLabel}"/>
								<TextBlock Text="{Binding StressLevel}" FontSize="15" FontWeight="Bold" Foreground="#DC2626"/>
							</StackPanel>
						</Border>
					</UniformGrid>

					<!-- ── ALERT BANNER ── -->
					<Border Background="White" BorderBrush="#D7DCE3" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,10" MinHeight="44">
						<TextBlock Text="{Binding AlertMessage}" FontSize="11"
                                   Foreground="#374151" TextWrapping="Wrap"
                                   Margin="14,10" VerticalAlignment="Center"/>
					</Border>

					<!-- ── HEALTH + RISK ── -->
					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="590*"/>
							<ColumnDefinition Width="589*"/>
						</Grid.ColumnDefinitions>

						<Border Style="{StaticResource Card}" Margin="0,0,10,0">
							<StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="Subsystem Health"/>
								<!-- Rectifier -->
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="32"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Rectifier" FontSize="12" VerticalAlignment="Center"/>
									<ProgressBar Grid.Column="1" Value="{Binding RectifierHealth}" Style="{StaticResource FlatBar}" Height="6" Margin="8,0" Background="#E5E7EB" Foreground="#F59E0B"/>
									<TextBlock Grid.Column="2" Text="{Binding RectifierHealth}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
								</Grid>
								<!-- Inverter -->
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="32"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Inverter" FontSize="12" VerticalAlignment="Center"/>
									<ProgressBar Grid.Column="1" Value="{Binding InverterHealth}" Style="{StaticResource FlatBar}" Height="6" Margin="8,0" Background="#E5E7EB" Foreground="#16A34A"/>
									<TextBlock Grid.Column="2" Text="{Binding InverterHealth}" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
								</Grid>
								<!-- Battery -->
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="32"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Battery" FontSize="12" VerticalAlignment="Center"/>
									<ProgressBar Grid.Column="1" Value="{Binding BatteryHealth}" Style="{StaticResource FlatBar}" Height="6" Margin="8,0" Background="#E5E7EB" Foreground="#F59E0B"/>
									<TextBlock Grid.Column="2" Text="{Binding BatteryHealth}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
								</Grid>
								<!-- DC Link -->
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="32"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="DC Link" FontSize="12" VerticalAlignment="Center"/>
									<ProgressBar Grid.Column="1" Value="{Binding DcLinkHealth}" Style="{StaticResource FlatBar}" Height="6" Margin="8,0" Background="#E5E7EB" Foreground="#F59E0B"/>
									<TextBlock Grid.Column="2" Text="{Binding DcLinkHealth}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
								</Grid>
								<!-- Thermal Stress -->
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="32"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Thermal" FontSize="12" VerticalAlignment="Center"/>
									<ProgressBar Grid.Column="1" Value="{Binding ThermalStress}" Style="{StaticResource FlatBar}" Height="6" Margin="8,0" Background="#E5E7EB" Foreground="#DC2626"/>
									<TextBlock Grid.Column="2" Text="{Binding ThermalStress}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
								</Grid>
							</StackPanel>
						</Border>

						<Border Style="{StaticResource Card}" RenderTransformOrigin="0.5,0.5" Margin="1,1,-2,1" Grid.Column="1">
							<Border.RenderTransform>
								<TransformGroup>
									<ScaleTransform/>
									<SkewTransform/>
									<RotateTransform Angle="-0.05"/>
									<TranslateTransform/>
								</TransformGroup>
							</Border.RenderTransform>
							<StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="Risk Forecast"/>
								<!-- Inverter -->
								<Grid Margin="0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="40"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Inverter Fail" FontSize="12"/>
									<TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#DC2626"><Run Text="{Binding InverterFailRisk}"/><Run Text="%"/></TextBlock>
								</Grid>
								<ProgressBar Value="{Binding InverterFailRisk}" Style="{StaticResource FlatBar}" Height="5" Margin="0,2,0,10" Background="#E5E7EB" Foreground="#DC2626"/>
								<!-- Rectifier -->
								<Grid Margin="0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="40"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Rectifier Fail" FontSize="12"/>
									<TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"><Run Text="{Binding RectifierFailRisk}"/><Run Text="%"/></TextBlock>
								</Grid>
								<ProgressBar Value="{Binding RectifierFailRisk}" Style="{StaticResource FlatBar}" Height="5" Margin="0,2,0,10" Background="#E5E7EB" Foreground="#F59E0B"/>
								<!-- Battery -->
								<Grid Margin="0,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="40"/>
									</Grid.ColumnDefinitions>
									<TextBlock Text="Battery Fail" FontSize="12"/>
									<TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"><Run Text="{Binding BatteryFailRisk}"/><Run Text="%"/></TextBlock>
								</Grid>
								<ProgressBar Value="{Binding BatteryFailRisk}" Style="{StaticResource FlatBar}" Height="5" Margin="0,2,0,0" Background="#E5E7EB" Foreground="#F59E0B"/>
							</StackPanel>
						</Border>
					</Grid>

					<!-- ── ROOT CAUSE + AI INSIGHT ── -->
					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Border Style="{StaticResource Card}" Margin="0,0,8,0">
							<StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="Root Cause Analysis"/>
								<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
									<StackPanel>
										<TextBlock Text="{Binding RootCause}" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
										<TextBlock FontSize="11" Foreground="#5A6474" Margin="0,0,0,8">
                                            <Run Text="Confidence: "/><Run Text="{Binding RootCauseConfidence}" FontWeight="SemiBold"/>
										</TextBlock>
										<TextBlock Text="Detected Patterns:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
										<ItemsControl ItemsSource="{Binding Patterns}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<TextBlock FontSize="11" Foreground="#374151" TextWrapping="Wrap" Margin="0,2">
                                                        <Run Text="→  "/><Run Text="{Binding Mode=OneWay}"/>
													</TextBlock>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</ScrollViewer>
							</StackPanel>
						</Border>

						<Border Style="{StaticResource Card}" Margin="0,0,4,0" Grid.Column="1">
							<StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="AI Insight Engine"/>
								<TextBlock Text="{Binding InsightSummary}" FontSize="11" Foreground="#5A6474" TextWrapping="Wrap" Margin="0,0,0,8"/>
								<TextBlock Text="Top Issues:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
								<ItemsControl ItemsSource="{Binding TopIssues}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock FontSize="11" Foreground="#5A6474" Margin="0,1">
                                                <Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/>
											</TextBlock>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Text="Recommended Actions:" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,4"/>
								<ItemsControl ItemsSource="{Binding Actions}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock FontSize="11" Foreground="#5A6474" Margin="0,1">
                                                <Run Text="•  "/><Run Text="{Binding Mode=OneWay}"/>
											</TextBlock>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<Separator Margin="0,8"/>
								<TextBlock FontSize="11">
                                    <Run Text="Confidence: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding InsightConfidence}" Foreground="#16A34A" FontWeight="SemiBold"/>
								</TextBlock>
							</StackPanel>
						</Border>
					</Grid>

					<!-- ── CHARTS ── -->
					<Grid Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Border Style="{StaticResource Card}" Margin="0,0,8,0">
							<StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="Electrical Trends"/>
								<lvc:CartesianChart Series="{Binding ElectricalSeries}"
                                                    XAxes="{Binding TimeAxis}"
                                                    Height="140" Margin="0,0,0,6"/>
								<TextBlock FontSize="11" Foreground="#5A6474">
                                    <Run Text="Vdc Mean: "/><Run Text="{Binding VdcMean, StringFormat=F1}"/><Run Text="V  |  Std: "/><Run Text="{Binding VdcStd, StringFormat=F2}"/><Run Text="V"/>
								</TextBlock>
							</StackPanel>
						</Border>

						<Border Style="{StaticResource Card}" Grid.Column="1" Margin="0,0,-10,0">
							<StackPanel>
								<TextBlock Style="{StaticResource SectionTitle}" Text="Alarm Distribution"/>
								<lvc:CartesianChart Series="{Binding AlarmSeries}"
                                                    XAxes="{Binding AlarmAxis}"
                                                    Height="140"/>
							</StackPanel>
						</Border>
					</Grid>

					<!-- ── ALARM LOG ── -->
					<Border Style="{StaticResource Card}">
						<StackPanel>
							<TextBlock Style="{StaticResource SectionTitle}" Text="Alarm Log"/>
							<DataGrid x:Name="AlarmGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="220" FontSize="11"
                                      Background="White" BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F0F2F5"
                                      RowBackground="White" AlternatingRowBackground="#FAFBFD">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Time"        Binding="{Binding OccurredAt, StringFormat=HH:mm:ss}" Width="80"/>
									<DataGridTextColumn Header="Code"        Binding="{Binding AlarmCode}"   Width="90"/>
									<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
									<DataGridTextColumn Header="Category"    Binding="{Binding Category}"    Width="100"/>
									<DataGridTextColumn Header="Severity"    Binding="{Binding Severity}"    Width="80"/>
									<DataGridTextColumn Header="Status"      Binding="{Binding Status}"      Width="70"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>
			<!-- Navigation pages -->
            <views:UploadVisitPage x:Name="PageUpload"   Grid.Row="1" Visibility="Collapsed"/>
            <views:ReportPage      x:Name="PageReport"   Grid.Row="1" Visibility="Collapsed"/>
            <views:SettingsPage    x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed"/>

		</Grid>
	</Grid>
</Window>