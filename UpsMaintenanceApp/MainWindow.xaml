<Window x:Class="UpsMaintenanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UPS Predictive Maintenance — Technovision 2026"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowState="Maximized"
        Background="{StaticResource BackgroundDark}">
 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
 
        <!-- Header bar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundPanel}"
                BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
 
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="22"
                               Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                    <TextBlock Text="UPS Predictive Maintenance" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="Technovision 2026" FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
 
                <Button Grid.Column="1" x:Name="BtnLoadFile" Content="📂  Load Excel File"
                        Click="BtnLoadFile_Click"
                        Padding="16,8"
                        Background="{StaticResource AccentBlue}"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" FontWeight="SemiBold" FontSize="13"/>
            </Grid>
        </Border>
 
        <!-- Tab content -->
        <TabControl Grid.Row="1"
                    Background="{StaticResource BackgroundDark}"
                    BorderThickness="0" Padding="0">
 
            <TabItem Header="Dashboard"
                     Foreground="{StaticResource TextPrimary}">
                <Grid Background="{StaticResource BackgroundDark}">
                    <TextBlock x:Name="TxtPlaceholder"
                               Text="Load an Excel file to populate the dashboard."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
 
            <TabItem Header="Alarms"
                     Foreground="{StaticResource TextPrimary}">
                <DataGrid x:Name="AlarmGrid"
                          Background="{StaticResource BackgroundDark}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderThickness="0"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#334155"
                          RowBackground="{StaticResource BackgroundDark}"
                          AlternatingRowBackground="{StaticResource BackgroundPanel}"
                          ColumnHeaderHeight="36"/>
            </TabItem>
 
        </TabControl>
 
        <!-- Status bar -->
        <Border Grid.Row="2" Background="#0B1120"
                BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready — load an Excel file to begin."
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="11" VerticalAlignment="Center" Margin="12,0"/>
        </Border>
    </Grid>
</Window>